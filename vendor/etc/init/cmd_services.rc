on boot
    setprop persist.sys.cmdservice.enable disable
    setprop persist.vendor.cmdservice.running stopped

service cmd_services /vendor/bin/cmd_services
    class main
    user root
    group system
    disabled
    oneshot

on property:persist.sys.cmdservice.enable=enable
    start cmd_services

on property:persist.sys.cmdservice.enable=disable
    stop cmd_services
